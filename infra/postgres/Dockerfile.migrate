FROM postgres:17-alpine

COPY migrations /migrations
COPY infra/postgres/migrate.sh /usr/local/bin/nexora-migrate
COPY infra/postgres/validate-production-env.sh /usr/local/bin/nexora-validate-production-env
COPY infra/postgres/backup.sh /usr/local/bin/nexora-backup
COPY infra/postgres/restore.sh /usr/local/bin/nexora-restore

RUN chmod 0555       /usr/local/bin/nexora-migrate       /usr/local/bin/nexora-validate-production-env       /usr/local/bin/nexora-backup       /usr/local/bin/nexora-restore     && chmod -R a=rX /migrations

CMD ["nexora-migrate"]
