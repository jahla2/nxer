# Force LF line endings for shell scripts and configs on all platforms
*.sh           text eol=lf
*.env          text eol=lf
*.env.*        text eol=lf
Dockerfile*    text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.conf         text eol=lf
*.json         text eol=lf
*.toml         text eol=lf
*.sql          text eol=lf
*.py           text eol=lf
*.go           text eol=lf
*.ts           text eol=lf
*.tsx          text eol=lf
*.js           text eol=lf
*.jsx          text eol=lf

# Windows-specific files keep CRLF
*.bat          text eol=crlf
*.cmd          text eol=crlf
*.ps1          text eol=crlf

# Binary files
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.woff         binary
*.woff2        binary
*.ttf          binary
*.eot          binary
