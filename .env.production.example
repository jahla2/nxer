# Nexora production environment template.
# Copy to .env.production and replace every CHANGE_ME value before startup.

ENVIRONMENT=production
NEXORA_VERSION=0.1.0-alpha
NEXORA_BIND_ADDRESS=127.0.0.1
NEXORA_HTTP_PORT=8080

PUBLIC_BASE_URL=https://api.example.com/v1
DASHBOARD_URL=https://api.example.com

# Provider
OPENROUTER_API_KEY=CHANGE_ME_PROVIDER_KEY
UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
FREE_MODEL_SYNC_INTERVAL_MINUTES=10
CATALOG_RELOAD_INTERVAL_SECONDS=15
CATALOG_CACHE_TTL_SECONDS=1800
PROVIDER_MAX_ATTEMPTS=2
PROVIDER_RETRY_BASE_MS=200
PROVIDER_RETRY_MAX_MS=1500
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_OPEN_SECONDS=30
PROVIDER_DIAL_TIMEOUT_SECONDS=5
PROVIDER_TLS_TIMEOUT_SECONDS=5
PROVIDER_RESPONSE_HEADER_TIMEOUT_SECONDS=30
PROVIDER_REQUEST_TIMEOUT_SECONDS=90
PROVIDER_STREAM_MAX_DURATION_SECONDS=300
PROVIDER_CATALOG_TIMEOUT_SECONDS=15
PROVIDER_IDLE_CONN_TIMEOUT_SECONDS=90
PROVIDER_MAX_IDLE_CONNS=100
PROVIDER_MAX_IDLE_CONNS_PER_HOST=20

# PostgreSQL
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql://nexora:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/nexora
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
USAGE_DB_MAX_OPEN_CONNS=4
USAGE_DB_MAX_IDLE_CONNS=2
USAGE_QUEUE_SIZE=2048
CATALOG_DB_MAX_OPEN_CONNS=4
CATALOG_DB_MAX_IDLE_CONNS=2

# Redis and Celery
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/2
CELERY_WORKER_CONCURRENCY=2
API_KEY_AUTH_CACHE_TTL_SECONDS=300

# Server-side security
API_KEY_HASH_PEPPER=CHANGE_ME_LONG_RANDOM_API_KEY_PEPPER
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SESSION_SECRET
CONTROL_ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_ADMIN_TOKEN
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_TTL_HOURS=24

# SMTP is required for production recovery and verification.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Nexora
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Development escape hatches must stay disabled.
LOCAL_BOOTSTRAP_ENABLED=false
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_DISPLAY_NAME=
DEV_EXPOSE_PASSWORD_RESET_TOKEN=false
DEV_EXPOSE_EMAIL_VERIFICATION_TOKEN=false

# Admission
GLOBAL_RPM_LIMIT=18
GLOBAL_DAILY_LIMIT=45
GLOBAL_MAX_CONCURRENT=8
DEFAULT_KEY_RPM=5
DEFAULT_KEY_DAILY=10
DEFAULT_KEY_MAX_CONCURRENT=2
DEFAULT_PROJECT_MAX_CONCURRENT=4
CONCURRENCY_LEASE_TTL_SECONDS=300

# Request / retention
MAX_REQUEST_BYTES=1048576
MAX_OUTPUT_TOKENS=4096
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_MAX_RESPONSE_BYTES=8388608
REQUEST_METADATA_RETENTION_DAYS=30
USAGE_AGGREGATION_BATCH_SIZE=5000
USAGE_AGGREGATION_MAX_BATCHES=4
AUDIT_LOG_RETENTION_DAYS=90
JOB_RUN_RETENTION_DAYS=14
AUTH_TOKEN_RETENTION_DAYS=7
JOB_RUN_STALE_MINUTES=120

# Optional Cloudflare named tunnel. Enable with Compose profile "tunnel".
# Configure the tunnel public hostname to use http://nginx:8080 as its origin.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
CLOUDFLARE_TUNNEL_TOKEN=
