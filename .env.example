# Copy this file to .env for local Docker Compose.
PUBLIC_BASE_URL=http://localhost:8080/v1
DASHBOARD_URL=http://localhost:8080
ENVIRONMENT=development

# Provider
# Required for real model catalog sync and inference.
OPENROUTER_API_KEY=
UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
FREE_MODEL_SYNC_INTERVAL_MINUTES=10

# PostgreSQL
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora-local-change-me
DATABASE_URL=postgresql://nexora:nexora-local-change-me@postgres:5432/nexora
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
USAGE_DB_MAX_OPEN_CONNS=4
USAGE_DB_MAX_IDLE_CONNS=2
USAGE_QUEUE_SIZE=2048
CATALOG_DB_MAX_OPEN_CONNS=4
CATALOG_DB_MAX_IDLE_CONNS=2

# Redis / Celery broker and coordination.
REDIS_PASSWORD=nexora-redis-local-change-me
REDIS_URL=redis://:nexora-redis-local-change-me@redis:6379/0
API_KEY_AUTH_CACHE_TTL_SECONDS=300

# Server-side security.
# Replace all development placeholders before any shared/non-local deployment.
API_KEY_HASH_PEPPER=local-dev-change-this-to-a-long-random-secret
SESSION_SECRET=local-dev-change-this-to-another-long-random-secret
CONTROL_ADMIN_TOKEN=local-dev-admin-token-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# Development-only bootstrap account. Disable outside local development.
LOCAL_BOOTSTRAP_ENABLED=true
LOCAL_ADMIN_EMAIL=local@nexora.dev
LOCAL_ADMIN_PASSWORD=change-me-local-only
LOCAL_ADMIN_DISPLAY_NAME=Local Developer
DEV_EXPOSE_PASSWORD_RESET_TOKEN=true

# Gateway admission defaults.
GLOBAL_RPM_LIMIT=18
GLOBAL_DAILY_LIMIT=45
GLOBAL_MAX_CONCURRENT=8
DEFAULT_KEY_RPM=5
DEFAULT_KEY_DAILY=10
DEFAULT_KEY_MAX_CONCURRENT=2
DEFAULT_PROJECT_MAX_CONCURRENT=4
CONCURRENCY_LEASE_TTL_SECONDS=300

# Request/retention limits.
MAX_REQUEST_BYTES=1048576
MAX_OUTPUT_TOKENS=4096
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_MAX_RESPONSE_BYTES=8388608
REQUEST_METADATA_RETENTION_DAYS=30
